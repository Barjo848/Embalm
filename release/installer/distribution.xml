<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Embalm</title>
    <license file="LICENSE.txt"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="app"/>
        <line choice="actions"/>
    </choices-outline>
    <choice id="app" title="Embalm" description="The app. Sandboxed, with no network access." enabled="false" selected="true">
        <pkg-ref id="com.embalm.pkg.app"/>
    </choice>
    <choice id="actions" title="Finder right-click actions" description="Adds Embalm (for any file) and Mummify (for embalmed files) to the right-click Quick Actions menu in Finder." selected="true">
        <pkg-ref id="com.embalm.pkg.actions"/>
    </choice>
    <pkg-ref id="com.embalm.pkg.app" version="@VERSION@">app.pkg</pkg-ref>
    <pkg-ref id="com.embalm.pkg.actions" version="@VERSION@">actions.pkg</pkg-ref>
</installer-gui-script>
